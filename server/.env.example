# HelpDesk Backend Environment Variables (.env)
#
# NOTE: Copy this to .env (which is git-ignored)
# The .env file is loaded by django-environ at startup
#
# For production, create .env.production or use environment variables

# ============================================
# Django Core Settings
# ============================================
# DEBUG mode (set to False in production)
DEBUG=True

# Secret key for Django (CHANGE THIS IN PRODUCTION!)
# Generate new: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-dev-key-change-in-production

# Allowed hosts (comma-separated)
# Examples: localhost,127.0.0.1,example.com,.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Environment name (development|staging|production)
ENVIRONMENT=development

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Database engine
DB_ENGINE=django.db.backends.postgresql

# Database name
DB_NAME=helpdesk_db

# Database user
DB_USER=admin

# Database password
DB_PASSWORD=password123

# Database host
# Docker: use 'db' (service name)
# Local: use 'localhost' or '127.0.0.1'
DB_HOST=db

# Database port
DB_PORT=5432

# Connection max age in seconds (0 = close after each request)
DB_CONN_MAX_AGE=600

# ============================================
# Redis Configuration
# ============================================
# Redis host
# Docker: use 'redis' (service name)
# Local: use 'localhost'
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# Redis password (if set)
REDIS_PASSWORD=

# Redis SSL/TLS
REDIS_SSL=False

# ============================================
# WebSocket/Channels Configuration
# ============================================
# Channel layers backend
# Options: channels_redis.core.RedisChannelLayer | channels.layers.InMemoryChannelLayer
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer

# Channel layer capacity
# Number of messages to buffer per channel
# Adjust based on expected load (higher = more memory)
CHANNEL_CAPACITY=5000

# Channel layer expiry time in seconds
# Messages older than this are discarded
# For mobile/slow networks: use 300+ seconds
# Default: 300 seconds (5 minutes)
CHANNEL_EXPIRY=300

# ============================================
# AJAX Long Polling Configuration (Fallback)
# ============================================
# Enable message queue for polling fallback
# When WebSocket fails, clients can poll for messages via HTTP
ENABLE_POLLING_FALLBACK=True

# Message queue expiry in seconds
# Queued messages will be auto-deleted after this time
# Default: 3600 seconds (1 hour)
MESSAGE_QUEUE_EXPIRY=3600

# Maximum messages to store per user
# Messages beyond this count are dropped (FIFO)
# Default: 1000 (high limit for mobile users)
MESSAGE_QUEUE_MAX_SIZE=1000

# ============================================
# CORS & Security
# ============================================
# CORS allowed origins (comma-separated)
# '*' = allow all (DEVELOPMENT ONLY!)
# Examples: http://localhost:5173,https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# CORS allow credentials
CORS_ALLOW_CREDENTIALS=True

# Secure SSL redirect (production only)
SECURE_SSL_REDIRECT=False

# Session cookie secure (use HTTPS)
SESSION_COOKIE_SECURE=False

# CSRF cookie secure (use HTTPS)
CSRF_COOKIE_SECURE=False

# ============================================
# JWT Authentication
# ============================================
# JWT access token lifetime in minutes
JWT_ACCESS_TOKEN_LIFETIME=1440

# JWT refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=7

# ============================================
# ML/AI Service Configuration
# ============================================
# ML service URL
# Local: http://localhost:8001
# Docker: http://host.docker.internal:8001 (Mac/Windows)
# Linux Docker: need to configure host gateway separately
ML_SERVICE_URL=http://host.docker.internal:8001/ticket

# ML service request timeout in seconds
ML_SERVICE_TIMEOUT=45

# Enable ML service integration
ENABLE_ML_SERVICE=True

# ============================================
# Email Configuration (SMTP) - Optional
# ============================================
# Email backend
# django.core.mail.backends.console.EmailBackend (development)
# django.core.mail.backends.smtp.EmailBackend (production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP host
EMAIL_HOST=smtp.gmail.com

# SMTP port
EMAIL_PORT=587

# Use TLS
EMAIL_USE_TLS=True

# SMTP username
EMAIL_HOST_USER=your-email@gmail.com

# SMTP password
EMAIL_HOST_PASSWORD=your-app-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@helpdesk.local

# ============================================
# Logging Configuration
# ============================================
# Log level (DEBUG|INFO|WARNING|ERROR|CRITICAL)
LOG_LEVEL=DEBUG

# Log to console
LOG_TO_CONSOLE=True

# Log to file
LOG_TO_FILE=False

# Log file path
LOG_FILE_PATH=/var/log/helpdesk/django.log

# ============================================
# API Configuration
# ============================================
# API version
API_VERSION=v1

# API base URL (for reverse URLs in emails, etc)
API_BASE_URL=http://localhost:8000

# ============================================
# Feature Flags
# ============================================
# Enable real-time updates
ENABLE_REALTIME_UPDATES=True

# Enable WebSocket
ENABLE_WEBSOCKET=True

# ============================================
# Nginx/SSL Configuration (Reverse Proxy)
# ============================================
# SSL certificate path (for Nginx)
# Development: Self-signed certificate
# Production: Let's Encrypt certificate via Certbot
# Docker volume mount: /etc/nginx/certs/fullchain.pem
NGINX_CERT_PATH=/etc/nginx/certs/fullchain.pem

# SSL private key path (for Nginx)
# Docker volume mount: /etc/nginx/certs/privkey.pem
NGINX_KEY_PATH=/etc/nginx/certs/privkey.pem

# ============================================
# Proxy Support Configuration (Django behind Nginx)
# ============================================
# Header name for forwarded client IP address
# Nginx sends X-Forwarded-For header
SECURE_PROXY_HEADER_ENVIRON=HTTP_X_FORWARDED_FOR

# Header name for original request protocol
# Nginx sends X-Forwarded-Proto header (http or https)
SECURE_PROXY_HEADER=HTTP_X_FORWARDED_PROTO

# Trusted proxy IPs/networks that are allowed to set X-Forwarded-* headers
# Format: comma-separated list
# Docker: '127.0.0.1,nginx,172.17.0.0/12' (internal network)
# Production: Add specific Nginx/LB IP addresses
TRUSTED_PROXIES=127.0.0.1,nginx,172.17.0.0/12

# Enable SSL redirect (only set True in production behind HTTPS Nginx proxy)
SECURE_SSL_REDIRECT=false

# Session/CSRF cookie security (only set True in production behind HTTPS Nginx proxy)
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# API Base URL (after going through Nginx proxy)
# For external URL generation, email links, etc.
# Development: http://localhost (Nginx on port 80/443)
# Production: https://api.example.com
API_BASE_URL=https://localhost

# ============================================
# Docker/Production Settings
# ============================================
# Number of Gunicorn workers (for production)
WEB_CONCURRENCY=4

# Number of threads per worker
GUNICORN_THREADS=2

# Timeout for Gunicorn workers in seconds
GUNICORN_TIMEOUT=120
