# HelpDesk Backend Environment Variables (.env)
# 
# NOTE: Copy this to .env (which is git-ignored)
# The .env file is loaded by django-environ at startup
#
# For production, create .env.production or use environment variables

# ============================================
# Django Core Settings
# ============================================
# DEBUG mode (set to False in production)
DEBUG=True

# Secret key for Django (CHANGE THIS IN PRODUCTION!)
# Generate new: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-dev-key-change-in-production

# Allowed hosts (comma-separated)
# Examples: localhost,127.0.0.1,example.com,.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Environment name (development|staging|production)
ENVIRONMENT=development

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Database engine
DB_ENGINE=django.db.backends.postgresql

# Database name
DB_NAME=helpdesk_db

# Database user
DB_USER=admin

# Database password
DB_PASSWORD=password123

# Database host
# Docker: use 'db' (service name)
# Local: use 'localhost' or '127.0.0.1'
DB_HOST=db

# Database port
DB_PORT=5432

# Connection max age in seconds (0 = close after each request)
DB_CONN_MAX_AGE=600

# ============================================
# Redis Configuration
# ============================================
# Redis host
# Docker: use 'redis' (service name)
# Local: use 'localhost'
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis database number
REDIS_DB=0

# Redis password (if set)
REDIS_PASSWORD=

# Redis SSL/TLS
REDIS_SSL=False

# ============================================
# WebSocket/Channels Configuration
# ============================================
# Channel layers backend
# Options: channels_redis.core.RedisChannelLayer | channels.layers.InMemoryChannelLayer
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer

# Channel layer capacity
# Number of messages to buffer per channel
# Adjust based on expected load (higher = more memory)
CHANNEL_CAPACITY=5000

# Channel layer expiry time in seconds
# Messages older than this are discarded
# For mobile/slow networks: use 300+ seconds
# Default: 300 seconds (5 minutes)
CHANNEL_EXPIRY=300

# ============================================
# CORS & Security
# ============================================
# CORS allowed origins (comma-separated)
# '*' = allow all (DEVELOPMENT ONLY!)
# Examples: http://localhost:5173,https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# CORS allow credentials
CORS_ALLOW_CREDENTIALS=True

# Secure SSL redirect (production only)
SECURE_SSL_REDIRECT=False

# Session cookie secure (use HTTPS)
SESSION_COOKIE_SECURE=False

# CSRF cookie secure (use HTTPS)
CSRF_COOKIE_SECURE=False

# ============================================
# JWT Authentication
# ============================================
# JWT access token lifetime in minutes
JWT_ACCESS_TOKEN_LIFETIME=1440

# JWT refresh token lifetime in days
JWT_REFRESH_TOKEN_LIFETIME=7

# ============================================
# ML/AI Service Configuration
# ============================================
# ML service URL
# Local: http://localhost:8001
# Docker: http://host.docker.internal:8001 (Mac/Windows)
# Linux Docker: need to configure host gateway separately
ML_SERVICE_URL=http://host.docker.internal:8001/ticket

# ML service request timeout in seconds
ML_SERVICE_TIMEOUT=45

# Enable ML service integration
ENABLE_ML_SERVICE=True

# ============================================
# Email Configuration (SMTP) - Optional
# ============================================
# Email backend
# django.core.mail.backends.console.EmailBackend (development)
# django.core.mail.backends.smtp.EmailBackend (production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP host
EMAIL_HOST=smtp.gmail.com

# SMTP port
EMAIL_PORT=587

# Use TLS
EMAIL_USE_TLS=True

# SMTP username
EMAIL_HOST_USER=your-email@gmail.com

# SMTP password
EMAIL_HOST_PASSWORD=your-app-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@helpdesk.local

# ============================================
# Logging Configuration
# ============================================
# Log level (DEBUG|INFO|WARNING|ERROR|CRITICAL)
LOG_LEVEL=DEBUG

# Log to console
LOG_TO_CONSOLE=True

# Log to file
LOG_TO_FILE=False

# Log file path
LOG_FILE_PATH=/var/log/helpdesk/django.log

# ============================================
# API Configuration
# ============================================
# API version
API_VERSION=v1

# API base URL (for reverse URLs in emails, etc)
API_BASE_URL=http://localhost:8000

# ============================================
# Feature Flags
# ============================================
# Enable real-time updates
ENABLE_REALTIME_UPDATES=True

# Enable WebSocket
ENABLE_WEBSOCKET=True

# ============================================
# Docker/Production Settings
# ============================================
# Number of Gunicorn workers (for production)
WEB_CONCURRENCY=4

# Number of threads per worker
GUNICORN_THREADS=2

# Timeout for Gunicorn workers in seconds
GUNICORN_TIMEOUT=120
