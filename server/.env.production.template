# HelpDesk Production Environment Configuration
# Copy this file to .env.production and fill in actual values

# ============================================
# Django Core Settings
# ============================================
DEBUG=False
SECRET_KEY=your-super-secret-key-here-generate-new-one
ENVIRONMENT=production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=helpdesk_db
DB_USER=helpdesk_user
DB_PASSWORD=your-secure-db-password-here
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=require
DB_CONN_MAX_AGE=600

# ============================================
# Redis Configuration (for Channels & Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password
REDIS_SSL=False

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-generate-new
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_TYPE_FIELD=token_type

# ============================================
# CORS & Security
# ============================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY

# ============================================
# Email Configuration (SMTP)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# ML/AI Service Configuration
# ============================================
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=30
ML_SERVICE_ENABLED=True
ENABLE_AI_SUGGESTIONS=True

# ============================================
# WebSocket Configuration
# ============================================
WEBSOCKET_ACCEPT_ALL=False
WEBSOCKET_AUTH_REQUIRED=True
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
CHANNEL_LAYERS_CONFIG_HOSTS=['localhost:6379']
NOTIFY_CHANNEL_GROUP=notifications
REALTIME_CHANNEL_GROUP=realtime_updates

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/helpdesk/django.log
LOG_FORMAT=verbose
ACCESS_LOG_FILE=/var/log/helpdesk/access.log
ERROR_LOG_FILE=/var/log/helpdesk/error.log

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
RATE_LIMIT_STORAGE=cache

# ============================================
# Feature Flags
# ============================================
ENABLE_ANALYTICS=True
ENABLE_CHAT=True
ENABLE_NOTIFICATIONS=True
ENABLE_REAL_TIME_UPDATES=True
ENABLE_ML_SERVICE=True

# ============================================
# Sentry Error Tracking (Optional)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================
# AWS/Cloud Storage (Optional)
# ============================================
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# ============================================
# Timezone & Localization
# ============================================
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
USE_I18N=True
USE_TZ=True

# ============================================
# Session & Cache
# ============================================
SESSION_ENGINE=django.contrib.sessions.backends.cache
SESSION_CACHE_ALIAS=default
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://localhost:6379/1

# ============================================
# API Versioning
# ============================================
API_VERSION=v1
API_BASE_URL=/api

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/var/backups/helpdesk

# ============================================
# Celery Task Queue (Optional)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
