# HelpDesk Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values

# API Configuration
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000

# Logging Level (development | info | warn | error)
VITE_LOG_LEVEL=development

# Application Settings
VITE_APP_NAME=HelpDesk
VITE_APP_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=true
