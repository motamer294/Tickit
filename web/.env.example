# HelpDesk Frontend Environment Variables (.env.local)
#
# NOTE: Copy this to .env.local (which is git-ignored)
# Changes to .env.local automatically reload dev server
#
# For production, use environment variables at build/runtime

# ============================================
# API Configuration
# ============================================
# REST API base URL (without trailing slash)
# Examples:
#   Local: http://localhost:8000/api
#   Remote: https://api.example.com/api
#   Docker: http://backend:8000/api
VITE_API_URL=http://localhost:8000/api

# API port (if different from default 8000)
# Leave empty to use VITE_API_URL
# Used for: Dynamic port configuration
VITE_API_PORT=8000

# API hostname/domain (if different from current domain)
# Leave empty to use current domain
# Used for: Remote development, different hostnames
VITE_API_HOST=localhost

# ============================================
# WebSocket Configuration
# ============================================
# WebSocket base URL
# NOTE: Automatically handles ws:// vs wss:// based on protocol
# Examples:
#   Local: ws://localhost:8000
#   Production: wss://api.example.com (handled by nginx proxy)
VITE_WS_URL=ws://localhost:8000

# WebSocket port (if different from API port 8000)
# Leave empty to use VITE_API_PORT or 8000
# Used for: Custom WebSocket port setup
VITE_WS_PORT=8000

# WebSocket hostname/domain (if different from API host)
# Leave empty to use VITE_API_HOST or current domain
# Used for: Separate WebSocket server, remote connections
VITE_WS_HOST=localhost

# ============================================
# Development Server Configuration
# ============================================
# Frontend dev server ports that should redirect to backend
# Comma-separated list: "5173,3000,3001"
# Default: "5173,3000" (Vite and legacy ports)
VITE_DEV_SERVER_PORTS=5173,3000

# ============================================
# WebSocket Features & HTTPS
# ============================================
# Enable polling fallback when WebSocket unavailable
VITE_ENABLE_WS_FALLBACK=true

# Initial polling interval in milliseconds (when fallback activated)
VITE_POLLING_INTERVAL=5000

# Maximum polling interval in milliseconds (with exponential backoff)
VITE_POLLING_MAX_INTERVAL=30000

# Use HTTPS/WSS for API and WebSocket (production behind Nginx reverse proxy)
# Set to true when deployed behind HTTPS Nginx proxy
# Set to false for local development (Nginx redirect http -> https still works)
VITE_USE_HTTPS=false

# HTTPS API and WebSocket URLs (used when VITE_USE_HTTPS=true)
# Set these when deploying to production
# Examples:
#   VITE_API_URL_HTTPS=https://api.example.com/api
#   VITE_WS_URL_HTTPS=wss://api.example.com
VITE_API_URL_HTTPS=https://localhost/api
VITE_WS_URL_HTTPS=wss://localhost

# ============================================
# Application Settings
# ============================================
# Application name (shown in UI)
VITE_APP_NAME=HelpDesk

# Request timeout in milliseconds
VITE_APP_TIMEOUT=10000

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# WebSocket connection timeout in milliseconds
VITE_WS_TIMEOUT=5000

# Logging level (development | info | warn | error | debug)
VITE_LOG_LEVEL=development

# ============================================
# Feature Flags
# ============================================
# Enable debug panel (Dev page)
VITE_ENABLE_DEBUG=true

# Enable analytics
VITE_ENABLE_ANALYTICS=false

# Enable verbose WebSocket logging
VITE_DEBUG_WEBSOCKET=false

# ============================================
# Environment Type
# ============================================
# Set NODE_ENV for build optimization
# Options: development | production | staging
# Note: Vite sets this automatically, but you can override
# NODE_ENV=development
